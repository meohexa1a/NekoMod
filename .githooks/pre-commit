#!/bin/sh
# =============================================================================
# NekoMod v3 Pre-Commit Hook (Architecture Lockdown & Quality Assurance)
# 1. Ngăn chặn việc sửa đổi vào module đã ĐÓNG BĂNG (trừ khi có cờ ALLOW_LOCKED_MODIFICATIONS=1).
# 2. Kiểm tra quy chuẩn đặt tên PascalCase cho class, object, interface.
# 3. Kiểm tra tính khớp nối giữa package declaration và đường dẫn thư mục.
# 4. Kiểm tra biên dịch Kotlin (Zero Compile Errors Gate).
# =============================================================================

# Lấy danh sách tệp đang nằm trong Git Staging Area (chỉ các file được thêm/sửa/đổi tên)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# -----------------------------------------------------------------------------
# 1. KIỂM TRA KHÓA KIẾN TRÚC (ARCHITECTURAL LOCKDOWN)
# -----------------------------------------------------------------------------
if [ "$ALLOW_LOCKED_MODIFICATIONS" != "1" ] && [ "$ALLOW_LOCKED_MODIFICATIONS" != "true" ]; then
    PROTECTED_PATHS="
src/main/kotlin/org/hubdustry/core/layout/
src/main/kotlin/org/hubdustry/core/graphics/
src/main/kotlin/org/hubdustry/core/compose/
"
    LOCK_VIOLATIONS=""
    for file in $STAGED_FILES; do
        for pattern in $PROTECTED_PATHS; do
            if [ -n "$pattern" ]; then
                case "$file" in
                    $pattern*)
                        LOCK_VIOLATIONS="$LOCK_VIOLATIONS\n  • $file"
                        break
                        ;;
                esac
            fi
        done
    done

    if [ -n "$LOCK_VIOLATIONS" ]; then
        echo ""
        echo "============================================================================="
        echo "🛑 [NEKOMOD ARCHITECTURE LOCKOUT] PHÁT HIỆN VI PHẠM KHÓA KIẾN TRÚC!"
        echo "============================================================================="
        echo "Bạn đang cố gắng commit vào các tệp thuộc module ĐÃ ĐÓNG BĂNG (🟢 Stable):"
        printf "$LOCK_VIOLATIONS\n"
        echo ""
        echo "LÝ DO:"
        echo "  Các module này đã hoàn thành kiểm thử toàn diện 100% (180+ tests),"
        echo "  được khóa quyền ghi hình học và đóng băng theo ADR-01..05."
        echo "  Nghiêm cấm tự ý sửa đổi để tránh gây hồi quy (regression) kiến trúc cốt lõi."
        echo ""
        echo "HƯỚNG XỬ LÝ:"
        echo "  1. Nếu vô tình stage nhầm, hãy unstage các tệp trên:"
        echo "     git restore --staged <đường-dẫn-tệp>"
        echo ""
        echo "  2. Nếu bạn có chủ đích mở khóa nâng cấp kiến trúc sau khi được Lead phê duyệt:"
        echo "     git commit --no-verify -m \"your commit message\""
        echo "     (hoặc set biến môi trường: ALLOW_LOCKED_MODIFICATIONS=1 git commit)"
        echo "============================================================================="
        echo ""
        exit 1
    fi
fi

# Lọc danh sách file Kotlin (.kt) trong staging
STAGED_KT_FILES=$(echo "$STAGED_FILES" | grep '\.kt$' || true)

if [ -n "$STAGED_KT_FILES" ]; then
    # -------------------------------------------------------------------------
    # 2. KIỂM TRA QUY CHUẨN ĐẶT TÊN PASCALCASE (CODING CONVENTIONS)
    # -------------------------------------------------------------------------
    NAMING_VIOLATIONS=""
    for file in $STAGED_KT_FILES; do
        if [ -f "$file" ]; then
            matches=$(grep -En '^[[:space:]]*(class|object|interface)[[:space:]]+[a-z]' "$file" || true)
            if [ -n "$matches" ]; then
                NAMING_VIOLATIONS="$NAMING_VIOLATIONS\n  • $file:\n$matches"
            fi
        fi
    done

    if [ -n "$NAMING_VIOLATIONS" ]; then
        echo ""
        echo "============================================================================="
        echo "🛑 [PRE-COMMIT] PHÁT HIỆN VI PHẠM QUY CHUẨN ĐẶT TÊN PASCALCASE!"
        echo "============================================================================="
        printf "$NAMING_VIOLATIONS\n"
        echo "LÝ DO: Tên class, object, interface trong Kotlin bắt buộc phải viết theo PascalCase."
        echo "============================================================================="
        echo ""
        exit 1
    fi

    # -------------------------------------------------------------------------
    # 3. KIỂM TRA TÍNH KHỚP NỐI PACKAGE DECLARATION & THƯ MỤC
    # -------------------------------------------------------------------------
    PACKAGE_VIOLATIONS=""
    for file in $STAGED_KT_FILES; do
        if [ -f "$file" ]; then
            pkg_line=$(grep -m 1 '^[[:space:]]*package[[:space:]]' "$file" || true)
            if [ -n "$pkg_line" ]; then
                pkg=$(echo "$pkg_line" | sed -E 's/^[[:space:]]*package[[:space:]]+([^;[:space:]]+).*/\1/')
                expected_dir=$(echo "$pkg" | tr '.' '/')
                case "$file" in
                    *"$expected_dir"*) ;;
                    *)
                        PACKAGE_VIOLATIONS="$PACKAGE_VIOLATIONS\n  • $file: package $pkg không khớp đường dẫn thư mục"
                        ;;
                esac
            fi
        fi
    done

    if [ -n "$PACKAGE_VIOLATIONS" ]; then
        echo ""
        echo "============================================================================="
        echo "🛑 [PRE-COMMIT] PHÁT HIỆN PACKAGE DECLARATION SAI ĐƯỜNG DẪN THƯ MỤC!"
        echo "============================================================================="
        printf "$PACKAGE_VIOLATIONS\n"
        echo "============================================================================="
        echo ""
        exit 1
    fi

    # -------------------------------------------------------------------------
    # 4. KIỂM TRA BIÊN DỊCH KOTLIN (ZERO COMPILE ERRORS GATE)
    # -------------------------------------------------------------------------
    echo "[PRE-COMMIT] Đang kiểm tra tính hợp lệ biên dịch Kotlin..."
    if [ "$OS" = "Windows_NT" ] && [ -f "./gradlew.bat" ]; then
        cmd.exe /c ".\gradlew.bat compileKotlin compileTestKotlin --quiet"
    elif [ -f "./gradlew" ]; then
        ./gradlew compileKotlin compileTestKotlin --quiet
    fi

    if [ $? -ne 0 ]; then
        echo ""
        echo "============================================================================="
        echo "🛑 [PRE-COMMIT] LỖI BIÊN DỊCH KOTLIN! MÃ NGUỒN KHÔNG THỂ BIÊN DỊCH THÀNH CÔNG."
        echo "============================================================================="
        echo "Vui lòng chạy './gradlew.bat compileKotlin' để kiểm tra chi tiết lỗi."
        echo "============================================================================="
        echo ""
        exit 1
    fi
fi

exit 0
